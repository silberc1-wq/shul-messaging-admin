    {
      "parameters": {
        "jsCode": "const cfg = $('Config (recordings)').first().json;\nconst b = $('Recording to save (from Supabase)').first().json.body;\nconst url = /\\.(mp3|wav)$/i.test(b.url) ? b.url : b.url + '.mp3';\nconst base = cfg.supabaseUrl + '/storage/v1/object/public/recordings/';\nconst cleanPath = b.path.replace(/\\.mp3$/i, '') + '-clean.mp3';\nreturn [{ json: { job: b.job, path: b.path, url, clean: b.clean === true, cleanPath,\n  publicUrl: base + b.path, cleanUrl: base + cleanPath } }];\n"
      },
