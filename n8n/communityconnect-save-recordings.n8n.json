    {
      "parameters": {
        "jsCode": "// Twilio recordings need the account's login (Account SID + Auth Token).\nconst cfg = $('Config (recordings)').first().json;\nconst b = $('Recording to save (from Supabase)').first().json.body;\nconst sid = (b.url.match(/\\/Accounts\\/(AC[0-9a-fA-F]+)\\//) || [])[1] || '';\nconst url = /\\.(mp3|wav)$/i.test(b.url) ? b.url : b.url + '.mp3';\nreturn [{ json: { job: b.job, path: b.path, url,\n  auth: 'Basic ' + Buffer.from(sid + ':' + cfg.twilioAuthToken).toString('base64'),\n  publicUrl: cfg.supabaseUrl + '/storage/v1/object/public/recordings/' + b.path } }];\n"
      },
