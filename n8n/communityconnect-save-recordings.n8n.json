        "jsCode": "// The speech service needs a file name ending in .mp3\nconst item = $input.first();\nitem.binary.data.fileName = 'voicemail.mp3';\nitem.binary.data.mimeType = 'audio/mpeg';\nreturn [item];\n"
      },
