      "typeVersion": 1,
      "position": [
        0,
        -200
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.body.to }}",
        "subject": "={{ $json.body.subject }}",
        "emailType": "html",
        "message": "={{ $json.body.html || ('<div style=\"font-family:Arial,sans-serif;font-size:15px;line-height:1.5\">' + String($json.body.text || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/(https:\\/\\/[^\\s<]+)/g,'<a href=\"$1\">$1</a>').replace(/\\n/g,'<br>') + '</div>') }}",
        "options": {
          "appendAttribution": false,
          "senderName": "={{ ($json.body.from_name || 'CommunityConnect').replace(/[<>\"\\r\\n]/g, '') }}",
          "replyTo": "={{ $json.body.reply_to || '' }}"
        }
