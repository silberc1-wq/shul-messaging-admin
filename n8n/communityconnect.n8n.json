    {
      "parameters": {
        "jsCode": "// CommunityConnect: turn the plan from Supabase into one Twilio request per text / call.\n// - Texts can carry a flyer (picture message).\n// - Calls with a recording play it twice; other calls read the message aloud twice.\n// - English is read with a natural (neural) male voice; text in Hebrew letters with a male Hebrew voice.\n// - Test calls (\"Call me to hear it\") and second tries for unanswered calls are not counted again.\n// - Delivery report: Twilio reports back (delivered / failed / answered / voicemail / no answer)\n//   to the \"Delivery status\" workflow; answering-machine detection only when the org turned it on.\nconst sid = $('Config').first().json.twilioAccountSid;\nconst esc = s => String(s || '').replace(/[<>&\"']/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '\"': '&quot;', \"'\": '&apos;' }[c]));\nconst enc = pairs => pairs.map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v)).join('&');\nconst HEBREW = /[֐-׿]/;\nconst say = text => HEBREW.test(text)\n  ? `<Say voice=\"Google.he-IL-Standard-B\" language=\"he-IL\">${esc(text)}</Say>`\n  : `<Say voice=\"Polly.Matthew-Neural\" language=\"en-US\">${esc(text)}</Say>`;\nfunction callTwiml(item) {\n  if (item.audio_url) {\n    const play = `<Play>${esc(item.audio_url)}</Play>`;\n    return `<Response><Pause length=\"1\"/>${item.intro ? say(item.intro) : ''}${play}<Pause length=\"1\"/>${say('Again.')}${play}</Response>`;\n  }\n  // \"say\" comes from Supabase: the whole call as it should be spoken (Ashkenazi words, the organization's chosen voice, said twice)\n  if (item.say) return `<Response><Pause length=\"1\"/>${item.say}</Response>`;   // already includes \"Again.\" and the repeat\n  return `<Response><Pause length=\"1\"/>${say(item.body)}<Pause length=\"1\"/>${say(HEBREW.test(item.body) ? 'שוב.' : 'Again.')}${say(item.body)}</Response>`;\n}\nfunction twilioRequest(item) {\n  const cb = item.status_url && item.history_id ? item.status_url + '?h=' + item.history_id : null;\n  if (item.channel === 'call') {\n    const pairs = [['To', item.to], ['From', item.from], ['Twiml', callTwiml(item)]];\n    if (cb) pairs.push(['StatusCallback', cb], ['StatusCallbackEvent', 'completed'], ['StatusCallbackMethod', 'POST']);\n    // Voicemail: wait for the greeting and beep, then play the whole message (the delivery report also shows Answered vs Voicemail)\n    if (item.amd) pairs.push(['MachineDetection', 'DetectMessageEnd'], ['MachineDetectionTimeout', '30']);\n    return { url: `https://api.twilio.com/2010-04-01/Accounts/${sid}/Calls.json`, form: enc(pairs) };\n  }\n  const pairs = [['To', item.to], ['From', item.from], ['Body', item.body]];\n  if (item.media_url) pairs.push(['MediaUrl', item.media_url]);\n  if (cb) pairs.push(['StatusCallback', cb]);\n  return { url: `https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, form: enc(pairs) };\n}\n\nconst plan = $input.first().json || {};\nconst out = [];\nfor (const m of plan.messages || []) out.push({ kind: 'message', channel: 'sms', to: m.to, from: m.from, body: m.body });\nfor (const b of plan.broadcasts || [])\n  for (const r of b.recipients || [])\n    out.push({ kind: b.retry ? 'retry' : b.history_id ? 'broadcast' : 'preview', history_id: b.history_id, channel: r.channel, to: r.to, from: b.from, body: r.body, say: r.say || null,\n               audio_url: r.audio_url || null, intro: r.intro || null, media_url: r.media_url || null,\n               status_url: b.status_url || null, amd: !!b.amd });\nreturn out.filter(i => i.to && i.from).map(i => ({ json: { ...i, ...twilioRequest(i) } }));\n"
      },
