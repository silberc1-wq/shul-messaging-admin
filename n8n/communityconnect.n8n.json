    {
      "parameters": {
        "jsCode": "const sid = $('Config').first().json.twilioAccountSid;\nconst esc = s => String(s || '').replace(/[<>&\"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','\"':'&quot;',\"'\":'&apos;'}[c]));\nconst enc = o => Object.entries(o).map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v)).join('&');\nfunction twilioRequest(item) {\n  if (item.channel === 'call') {\n    const say = `<Say voice=\"Polly.Matthew-Neural\">${esc(item.body)}</Say>`;\n    return { url: `https://api.twilio.com/2010-04-01/Accounts/${sid}/Calls.json`,\n             form: enc({ To: item.to, From: item.from, Twiml: `<Response><Pause length=\"1\"/>${say}<Pause length=\"1\"/><Say voice=\"Polly.Matthew-Neural\">Again.</Say>${say}</Response>` }) };\n  }\n  return { url: `https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, form: enc({ To: item.to, From: item.from, Body: item.body }) };\n}\n\n// \"Message sent\" confirmation back to whoever sent the broadcast\nreturn $input.all().map(i => i.json).filter(r => r.notify && r.to && r.from)\n  .map(r => ({ json: { ...r, ...twilioRequest({ channel: 'sms', to: r.to, from: r.from, body: r.body }) } }));\n"
      },
