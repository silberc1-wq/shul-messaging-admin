      "parameters": {
        "jsCode": "\n// Twilio signs every request: base64(HMAC-SHA1(authToken, URL + sorted params)). Build the string to check.\nconst cfg = $('Config').first().json;\nconst b = $json.body || {};\nlet base = cfg.inboundWebhookUrl;\nfor (const k of Object.keys(b).sort()) base += k + b[k];\nreturn [{ json: { ...$json, sigBase: base, sigHeader: ($json.headers || {})['x-twilio-signature'] || '' } }];\n"
      },
      "id": "7fb18ead-05de-45ed-bb5a-6efd2110312e",
      "name": "Build Signature Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        120
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA1",
        "value": "={{ $json.sigBase }}",
        "dataPropertyName": "expected",
        "secret": "={{ $('Config').first().json.twilioAuthToken }}",
        "encoding": "base64"
      },
      "id": "09f050dd-8470-4066-b0d2-719c87388005",
      "name": "Twilio Signature",
      "type": "n8n-nodes-base.crypto",
