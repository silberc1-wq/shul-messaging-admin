    {
      "parameters": {
        "jsCode": "\nconst sid = $('Config').first().json.twilioAccountSid;\nconst esc = s => String(s || '').replace(/[<>&\"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','\"':'&quot;',\"'\":'&apos;'}[c]));\nconst enc = o => Object.entries(o).map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v)).join('&');\nfunction twilioRequest(item) {\n  if (item.channel === 'call') {\n    const say = `<Say voice=\"alice\">${esc(item.body)}</Say>`;\n    return { url: `https://api.twilio.com/2010-04-01/Accounts/${sid}/Calls.json`,\n             form: enc({ To: item.to, From: item.from, Twiml: `<Response><Pause length=\"1\"/>${say}<Pause length=\"1\"/><Say voice=\"alice\">Again.</Say>${say}</Response>` }) };\n  }\n  return { url: `https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, form: enc({ To: item.to, From: item.from, Body: item.body }) };\n}\n\n// Turn the plan from Supabase into one item per text / call\nconst plan = $input.first().json || {};\nconst out = [];\nfor (const m of plan.messages || []) out.push({ kind: 'message', channel: 'sms', to: m.to, from: m.from, body: m.body });\nfor (const b of plan.broadcasts || [])\n  for (const r of b.recipients || [])\n    out.push({ kind: 'broadcast', history_id: b.history_id, channel: r.channel, to: r.to, from: b.from, body: r.body });\nreturn out.filter(i => i.to && i.from).map(i => ({ json: { ...i, ...twilioRequest(i) } }));\n"
      },
      "id": "8d61a95c-5f78-45fb-81ac-be10a40a440c",
      "name": "Expand Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1640,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "twilioApi",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/x-www-form-urlencoded",
        "body": "={{ $json.form }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          }
        }
      },
      "id": "79009c5f-26ff-4d5a-a852-6a4709af5de6",
      "name": "Twilio: Send Texts & Calls",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1860,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "\n// Count results per broadcast (failed items carry \"error\" because the Twilio node continues on error)\nconst sent = $('Expand Plan').all();\nconst results = $input.all();\nconst per = {};\nsent.forEach((s, i) => {\n  const it = s.json;\n  if (it.kind !== 'broadcast') return;\n  const r = (results[i] || {}).json || {};\n  const ok = !r.error && (r.sid || r.status);\n  const t = per[it.history_id] ||= { history_id: it.history_id, texts: 0, calls: 0, failed: 0 };\n  if (!ok) t.failed++; else if (it.channel === 'call') t.calls++; else t.texts++;\n});\nreturn Object.values(per).map(t => ({ json: t }));\n"
      },
      "id": "e1007460-6c1f-40dd-80f7-dc3550d05f66",
      "name": "Tally Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/record_broadcast_result",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_history_id: $json.history_id, p_texts: $json.texts, p_calls: $json.calls, p_failed: $json.failed }) }}",
        "options": {}
      },
      "id": "ea185253-29ee-4332-b2ae-782756af0a1f",
      "name": "Record Broadcast Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2300,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst sid = $('Config').first().json.twilioAccountSid;\nconst esc = s => String(s || '').replace(/[<>&\"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','\"':'&quot;',\"'\":'&apos;'}[c]));\nconst enc = o => Object.entries(o).map(([k, v]) => encodeURIComponent(k) + '=' + encodeURIComponent(v)).join('&');\nfunction twilioRequest(item) {\n  if (item.channel === 'call') {\n    const say = `<Say voice=\"alice\">${esc(item.body)}</Say>`;\n    return { url: `https://api.twilio.com/2010-04-01/Accounts/${sid}/Calls.json`,\n             form: enc({ To: item.to, From: item.from, Twiml: `<Response><Pause length=\"1\"/>${say}<Pause length=\"1\"/><Say voice=\"alice\">Again.</Say>${say}</Response>` }) };\n  }\n  return { url: `https://api.twilio.com/2010-04-01/Accounts/${sid}/Messages.json`, form: enc({ To: item.to, From: item.from, Body: item.body }) };\n}\n\n// \"Message sent\" confirmation back to whoever sent the broadcast\nreturn $input.all().map(i => i.json).filter(r => r.notify && r.to && r.from)\n  .map(r => ({ json: { ...r, ...twilioRequest({ channel: 'sms', to: r.to, from: r.from, body: r.body }) } }));\n"
      },
