    {
      "parameters": {
        "jsCode": "\n// Stripe events -> what to record in Supabase\nconst e = $input.first().json;\nconst o = (e.data && e.data.object) || {};\nif (e.type === 'checkout.session.completed' && o.client_reference_id) {\n  return [{ json: { fn: 'mark_signup_paid', body: { p_signup_id: o.client_reference_id, p_provider: 'stripe',\n    p_customer: o.customer || '', p_subscription: o.subscription || '', p_amount: (o.amount_total || 0) / 100 } } }];\n}\nif (e.type === 'invoice.paid' && o.subscription && o.billing_reason !== 'subscription_create') {\n  const end = o.lines && o.lines.data && o.lines.data[0] && o.lines.data[0].period ? o.lines.data[0].period.end : null;\n  return [{ json: { fn: 'extend_paid_until', body: { p_subscription: o.subscription,\n    p_period_end: new Date((end || Date.now() / 1000) * 1000).toISOString().slice(0, 10), p_amount: (o.amount_paid || 0) / 100 } } }];\n}\nreturn [];\n"
      },
      "id": "6896b3b4-113e-49b6-a4d3-407271cfe372",
      "name": "Read Payment",
