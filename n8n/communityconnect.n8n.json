    {
      "parameters": {
        "jsCode": "// Stripe events -> what to record in Supabase\n// - checkout completed: a new signup paid, or a credit pack was bought (both use client_reference_id)\n// - subscription updated: plan changed in the customer portal -> switch plan and monthly credits\n// - invoice paid (renewals): extend \"paid until\"\nconst e = $input.first().json;\nconst o = (e.data && e.data.object) || {};\nif (e.type === 'checkout.session.completed' && o.client_reference_id) {\n  return [{ json: { fn: 'mark_signup_paid', body: { p_signup_id: o.client_reference_id, p_provider: 'stripe',\n    p_customer: o.customer || '', p_subscription: o.subscription || '', p_amount: (o.amount_total || 0) / 100 } } }];\n}\nif (e.type === 'customer.subscription.updated' && o.id) {\n  const it = o.items && o.items.data && o.items.data[0]; const pr = it && (it.price || it.plan);\n  if (pr) return [{ json: { fn: 'stripe_plan_changed', body: { p_subscription: o.id,\n    p_unit_amount: (pr.unit_amount != null ? pr.unit_amount : pr.amount || 0) / 100,\n    p_interval: (pr.recurring && pr.recurring.interval) || pr.interval || 'month' } } }];\n}\nif (e.type === 'invoice.paid' && o.subscription && o.billing_reason !== 'subscription_create') {\n  const end = o.lines && o.lines.data && o.lines.data[0] && o.lines.data[0].period ? o.lines.data[0].period.end : null;\n  return [{ json: { fn: 'extend_paid_until', body: { p_subscription: o.subscription,\n    p_period_end: new Date((end || Date.now() / 1000) * 1000).toISOString().slice(0, 10), p_amount: (o.amount_paid || 0) / 100 } } }];\n}\nreturn [];\n"
      },
