    {
      "parameters": {
        "jsCode": "// Twilio signs every request: base64(HMAC-SHA1(authToken, full URL + sorted POST params)).\n// Our callback links add \"?h=<broadcast id>\", which is part of the signed URL.\nconst cfg = $('Config (status)').first().json;\nconst b = $json.body || {};\nconst q = $json.query || {};\nlet base = cfg.statusWebhookUrl + (q.h ? '?h=' + q.h : '');\nfor (const k of Object.keys(b).sort()) base += k + b[k];\nconst h = /^[0-9a-f-]{36}$/i.test(q.h || '') ? q.h : null;\nreturn [{ json: { ...$json, historyId: h, sigBase: base, sigHeader: ($json.headers || {})['x-twilio-signature'] || '' } }];\n"
      },
      "name": "Build Signature Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "8475c32e-1d2b-494d-93ef-8254416540f7"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e075cd66-1ddc-4657-951c-d52fba0629a0",
              "leftValue": "={{ $json.sigOk === true && !!$json.historyId }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
