     },
     "conditions": [
      {
       "id": "9c172ca4-eeb3-40b9-80cf-fe9db3b11d72",
       "leftValue": "={{ $json.sigHeader !== '' && $json.expected === $json.sigHeader }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
