              "name": "supabaseUrl",
              "value": "https://zuyqaicvnpwqawfxakjg.supabase.co",
              "type": "string"
            },
            {
              "id": "d7566cf2-ec5d-4989-af89-a6382aa542a2",
              "name": "voiceWebhookUrl",
              "value": "https://n8n.punchverification.com/webhook/voice-a9f4e86705730fc7174e",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
