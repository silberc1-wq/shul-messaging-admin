      "id": "6a6c8a6e-4c99-487b-bc6f-1dedf4ecaca2",
      "name": "Config (voice)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Twilio signs every request: base64(HMAC-SHA1(authToken, full URL + sorted POST params)).\n// Our own step links add \"?s=<step>\", which is part of the signed URL.\nconst cfg = $('Config (voice)').first().json;\nconst b = $json.body || {};\nconst q = $json.query || {};\nlet base = cfg.voiceWebhookUrl + (q.s ? '?s=' + q.s : '');\nfor (const k of Object.keys(b).sort()) base += k + b[k];\nreturn [{ json: { ...$json, sigBase: base, sigHeader: ($json.headers || {})['x-twilio-signature'] || '' } }];\n"
      },
      "id": "2914ec3d-30cf-44d5-9963-600faa0dc189",
      "name": "Build Signature Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "9c172ca4-eeb3-40b9-80cf-fe9db3b11d72",
              "leftValue": "={{ $json.sigOk === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "df97bf59-75a0-4958-957d-f95c9bdf1675",
      "name": "Really from Twilio?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config (voice)').first().json.supabaseUrl }}/rest/v1/rpc/handle_voice",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_call_sid: $json.body.CallSid, p_from: $json.body.From, p_to: $json.body.To, p_step: ($json.query || {}).s || '', p_digits: $json.body.Digits || null, p_recording_url: $json.body.RecordingUrl || null, p_recording_seconds: parseInt($json.body.RecordingDuration || '0', 10) || null, p_base_url: $('Config (voice)').first().json.voiceWebhookUrl, p_transcript: $json.body.TranscriptionText || null }) }}",
        "options": {}
      },
      "id": "c62e458d-4aba-4742-85b1-9b86218e8f5e",
      "name": "Handle Call (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        120
      ],
      "credentials": {
        "supabaseApi": {
          "id": "UJKemDkIPKxRY4nb",
          "name": "Supabase account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ '<?xml version=\"1.0\" encoding=\"UTF-8\"?>' + ($json.twiml || '<Response><Say voice=\"Polly.Matthew-Neural\">Sorry, something went wrong. Please try again later.</Say><Hangup/></Response>') }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/xml"
              }
            ]
          }
        }
      },
      "id": "9ab366f7-89e0-445b-b7c6-021e01bdfdfd",
      "name": "Answer the Call",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
