    },
    {
      "parameters": {
        "content": "## CommunityConnect: voice\n\nAnswers calls to every organization's number. No passwords in this workflow: the Twilio check is done by Supabase (token in Supabase Vault), and **Handle Call** uses the Supabase credential.\n\nAfter pasting: open **Check Twilio signature** and **Handle Call**, make sure the Supabase credential is picked, then **Publish**.",
        "height": 360,
        "width": 520,
        "color": 5
      },
      "id": "7ab124a0-8cfd-4c17-ab83-40eebf17585b",
      "name": "Read Me",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -260
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config (voice)').first().json.supabaseUrl }}/rest/v1/rpc/check_twilio",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_base: $json.sigBase, p_sig: $json.sigHeader }) }}",
        "options": {}
      },
      "id": "02cf7716-d128-4089-9465-f3e8a455d3c2",
      "name": "Check Twilio signature (Supabase)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "credentials": {
        "supabaseApi": {
          "id": "UJKemDkIPKxRY4nb",
          "name": "Supabase account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Keep the original Twilio request and add the check result\nconst src = $('Build Signature Check').first().json;\nreturn [{ json: { ...src, sigOk: $json.ok === true } }];\n"
      },
      "id": "5ac25787-dca1-4865-a2ba-2a3102430198",
      "name": "Signature result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
